# 이 파일을 복사해 .env를 만들고 값을 채우세요. .env는 Git에 올라가지 않습니다.

# 뉴스 API (F-01)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GUARDIAN_API_KEY=

# AI (임베딩 + 요약)
OPENAI_API_KEY=
# (선택) 링크 요약(F-03) 모델과 하루 한도 — 비우면 아래 기본값
# OPENAI_SUMMARY_MODEL=gpt-5.4-mini
# AI_SUMMARY_LIMIT_USER=20
# AI_SUMMARY_LIMIT_IP=50
# AI_SUMMARY_LIMIT_TOTAL=300
# (선택) AI 이슈 묶기(F-08) — 같은 이슈로 묶는 유사도 기준과 하루 한도
# CLUSTER_SIMILARITY_THRESHOLD=0.32
# AI_CLUSTER_LIMIT_USER=10
# AI_CLUSTER_LIMIT_IP=30
# AI_CLUSTER_LIMIT_TOTAL=200
# 보드 질의응답 (F-12): 근거로 쓸 최소 유사도와 하루 질문 한도
# QA_MIN_SIMILARITY=0.25
# AI_QA_LIMIT_USER=30
# AI_QA_LIMIT_IP=60
# AI_QA_LIMIT_TOTAL=300

# 로컬 개발 DB (docker-compose.yml)
DATABASE_URL=postgres://moyobom:moyobom@localhost:5433/moyobom
PORT=4000

# 테스트 전용 DB (DB 테스트가 데이터를 지우므로 개발 DB와 분리)
TEST_DATABASE_URL=postgres://moyobom:moyobom@localhost:5433/moyobom_test

# (선택) false면 뉴스 자동 수집을 끔 — 개발 중 API 호출을 아낄 때
# NEWS_COLLECTOR_ENABLED=false

# 로그인 토큰 서명 키 — 32자 이상 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
# 화면 주소 (쿠키 인증 요청의 Origin 확인용)
APP_ORIGIN=http://localhost:5173

# 카카오 로그인 (developers.kakao.com → [앱] → [플랫폼 키] → [REST API 키])
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 로그인 (developers.naver.com → 애플리케이션 등록 → "네이버 로그인") — 위 뉴스 검색용 NAVER_CLIENT_ID와는 다른 키
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
